# Copy this file to .env and fill in your values. Never commit .env.
# Only the PUBLIC anon / publishable key belongs here. NEVER put the service-role key in a frontend app.
VITE_SUPABASE_URL=https://mimobvudcwnbupwfghpd.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Default data mode when the dashboard opens: "test" (sample bins) or "live" (Supabase)
VITE_DATA_MODE=test

# Fill-level threshold (%) at which a bin is considered full and added to the route
VITE_FILL_THRESHOLD=90

# Depot / truck start location (default: Malkajgiri, Hyderabad)
VITE_DEPOT_NAME=Malkajgiri, Hyderabad
VITE_DEPOT_LAT=17.4475
VITE_DEPOT_LNG=78.5268

# Road routing (OSRM). Leave as-is for the public demo server, or point at your own OSRM.
VITE_OSRM_URL=https://router.project-osrm.org
# Used only when road routing is unavailable (straight-line fallback)
VITE_FALLBACK_SPEED_KMH=25
# Minutes spent at each bin emptying it
VITE_SERVICE_MIN_PER_BIN=2

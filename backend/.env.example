# Copy to backend/.env for local runs (git-ignored). On Render, set these in the service's Environment tab.

SUPABASE_URL=https://mimobvudcwnbupwfghpd.supabase.co
# Supabase Dashboard -> Project Settings -> API Keys -> "secret" key (sb_secret_...), or the legacy service_role key.
# SERVER ONLY. Never put this in the frontend, the ESP32, or git.
SUPABASE_SECRET_KEY=your-secret-key

# One secret per bin, comma separated: BIN-ID:secret. Use long random strings
# (e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))").
# The same secret goes into that ESP32's secrets.h as DEVICE_KEY.
DEVICE_KEYS=BIN-001:change-me-to-a-long-random-string

# Dashboard origins allowed to call the API from a browser (comma separated). Empty = allow all.
CORS_ORIGINS=http://localhost:5173

FILL_THRESHOLD=90
DEPOT_NAME=Malkajgiri, Hyderabad
DEPOT_LAT=17.4475
DEPOT_LNG=78.5268
OSRM_URL=https://router.project-osrm.org
FALLBACK_SPEED_KMH=25
SERVICE_MIN_PER_BIN=2
MIN_READING_INTERVAL_SEC=2
